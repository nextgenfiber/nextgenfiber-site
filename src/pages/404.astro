---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Page not found" description="This page does not exist.">
  <section class="section nf">
    <div class="wrap">
      <span class="index"><b>404</b> · Span not found</span>
      <h1 class="h1">This line ends here.</h1>
      <p class="lead">The page you were looking for moved or never existed.</p>
      <div class="nf__act">
        <a class="btn" href="/">Back to home <Arrow /></a>
        <a class="btn btn--ghost" href="/contact">Get a quote</a>
      </div>
      <svg class="nf__svg" viewBox="0 0 600 40" fill="none" aria-hidden="true">
        <path d="M0 16 H 380" stroke="var(--ink)" stroke-width="2.4" />
        <path d="M0 24 H 360" stroke="var(--gold)" stroke-width="2.4" />
        <path d="M392 8 l 16 24 M 408 8 l -16 24" stroke="var(--mid)" stroke-width="1.4" />
      </svg>
    </div>
  </section>
</Base>
<style>
  .nf .wrap { display: grid; gap: 1.6rem; justify-items: start; }
  .nf__act { display: flex; flex-wrap: wrap; gap: .75rem; }
  .nf__svg { width: min(600px, 100%); margin-top: 2rem; }
</style>
