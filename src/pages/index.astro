---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Photo from '../components/Photo.astro';
import USMap from '../components/USMap.astro';
import { jobsites, hq, extraStates } from '../data/jobsites';
import { company, stats, markets, states } from '../data/site';
import { services } from '../data/services';

const process = [
  { t: 'Scope & prints', d: 'Send us the prints, footage and schedule. We confirm scope, rate and crew mix before we commit.' },
  { t: 'Mobilize', d: 'Crews and equipment on site, typically within 48 hours of award, with locates called in.' },
  { t: 'Build & report', d: 'Daily production reports and GPS-stamped photos, so your PM sees progress without chasing us.' },
  { t: 'Closeout', d: 'Redlines, as-builts, photos and OTDR results handed over with the work, ready for your billing.' },
];
---
<Base headerTone="overlay" title="NextGen Fiber | Fiber Construction Subcontractor, Knoxville TN" description="Aerial, underground/HDD, fiber pulling and splicing crews for prime contractors across Tennessee and the Southeast. Knoxville, TN. Building fiber since 2023.">

  <!-- HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="hero__media" aria-hidden="true">
      <img class="hero__poster" src="/img/photos/hero-poster.webp" srcset="/img/photos/hero-poster-800.webp 800w, /img/photos/hero-poster-1280.webp 1280w, /img/photos/hero-poster.webp 1920w" sizes="100vw" width="1920" height="1080" alt="" fetchpriority="high" decoding="async" />
      <video class="hero__video" muted loop playsinline preload="auto" width="1920" height="1080" data-hero-video></video>
      <script is:inline>
        // Start the hero loop as soon as the element exists (not after page
        // load). Skipped for reduced motion and Save-Data / slow connections.
        (function () {
          var v = document.querySelector('[data-hero-video]');
          var c = navigator.connection || {};
          if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches || c.saveData || /2g|3g/.test(c.effectiveType || '')) return;
          v.addEventListener('playing', function () { v.classList.add('is-playing'); }, { once: true });
          v.src = innerWidth >= 900 ? '/video/hero-loop-1080.mp4' : '/video/hero-loop-720.mp4';
          var p = v.play(); if (p && p.catch) p.catch(function () {});
        })();
      </script>
      <div class="hero__shade"></div>
    </div>
    <div class="wrap hero__inner">
      <p class="hero__kicker">Fiber construction crews · Knoxville, Tennessee</p>
      <h1 class="hero__h1" data-split>Every connection starts with people.</h1>
      <p class="hero__lead">Aerial, underground and splicing for prime contractors in {states.length} states. Our own drill, our own crews, and closeout paperwork that doesn't hold up your billing.</p>
      <div class="hero__act">
        <a class="btn btn--light" href="/contact">Get a quote <Arrow /></a>
        <a class="hero__call" href={company.phoneHref}>or call {company.phone}</a>
      </div>
    </div>
    <p class="hero__cap">Filmed on NextGen Fiber job sites by SPM Creative</p>
  </section>

  <!-- STATS -->
  <section class="stats" aria-label="Track record">
    <div class="wrap">
      <div class="stats__row">
        {stats.map((s, i) => (
          <div class="stat" data-reveal data-reveal-delay={String(i)}>
            <p class="stat-num">
              {s.suffix ? <span data-count={String(s.value)}>{s.value}</span> : <span>{s.value}</span>}{s.suffix && <span>{s.suffix}</span>}
              {s.unit && <span class="stat__unit">{s.unit}</span>}
            </p>
            <p class="stat__label">{s.label}</p>
          </div>
        ))}
      </div>
      <p class="annot stats__note">Figures from invoiced production, April 2023 – July 2026. Line items are not added together.</p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section svc">
    <div class="wrap grid">
      <header class="svc__head">
        <span class="label">Capabilities</span>
        <h2 class="h2" data-split>One subcontractor, from strand to splice.</h2>
        <p class="lead">Five crew types that cover a full fiber build. Hire one, or run the whole route with us.</p>
        <a class="link" href="/services">All services <Arrow /></a>
      </header>
      <ol class="svc__list">
        {services.map((s, i) => (
          <li data-reveal data-reveal-delay={String(Math.min(i, 4))}>
            <a href={`/services/${s.slug}`} class="svc__row">
              <span class="svc__name">{s.name}</span>
              <span class="svc__short">{s.short}</span>
              <span class="svc__go"><Arrow /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CULTURE -->
  <section class="section--tight cult bg-paper">
    <div class="wrap grid cult__grid">
      <div class="cult__head">
        <span class="label">Our culture</span>
        <h2 class="h2" data-split>Treat people the way you want to be treated.</h2>
      </div>
      <div class="cult__body">
        <p class="lead">That’s how we treat our crews, and how our crews treat your job: honest work, respect on site, and people who stay.</p>
        <a class="link" href="/culture">How we work together <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- CINEMA: BUILT FOR THE FIELD -->
  <section class="cine cine--left">
    <div class="cine__media" data-parallax>
      <Photo src="/img/photos/field-bucket-line.webp" width={2400} height={1350} sizes="100vw" alt="NextGen Fiber lineman in the bucket at a pole line with aerial splice enclosures, rural road in the background" />
    </div>
    <div class="cine__shade" aria-hidden="true"></div>
    <div class="wrap cine__inner">
      <div class="cine__copy">
        <span class="label">In the field</span>
        <h2 class="h2" data-split>Built for the field.</h2>
        <p class="lead">Our crews run their own equipment and their own paperwork. Your project manager focuses on the build, not on chasing a subcontractor.</p>
      </div>
      <dl class="cine__facts">
        <div><dt>Mobilization</dt><dd>Typically within 48 hours of award</dd></div>
        <div><dt>Underground</dt><dd>Own Vermeer D20x22 drill and missile crews</dd></div>
        <div><dt>Documentation</dt><dd>GPS-stamped photos, redlines, as-builts, OTDR</dd></div>
        <div><dt>Coverage</dt><dd>{states.length} states, from Alabama to Wisconsin</dd></div>
      </dl>
    </div>
    <p class="cine__cap">Aerial crew at the pole line · Filmed by SPM Creative</p>
  </section>

  <!-- PROCESS -->
  <section class="section process bg-stone">
    <div class="wrap">
      <header class="process__head grid">
        <div class="process__title"><span class="label">How we work</span><h2 class="h2" data-split>From award to closeout.</h2></div>
      </header>
      <ol class="process__steps">
        {process.map((p, i) => (
          <li data-reveal data-reveal-delay={String(i)}>
            <span class="process__line" aria-hidden="true"></span>
            <h3 class="h3">{p.t}</h3>
            <p class="muted">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CINEMA: CLOSEOUT PROOF -->
  <section class="cine cine--right">
    <div class="cine__media" data-parallax>
      <Photo src="/img/photos/route-map-tablet-wide.webp" width={2400} height={1350} sizes="100vw" alt="Crew reviewing the route map and redlines on a tablet inside the truck" />
    </div>
    <div class="cine__shade" aria-hidden="true"></div>
    <div class="wrap cine__inner">
      <div class="cine__copy">
        <span class="label">Closeout-ready</span>
        <h2 class="h2" data-split>Documentation your PM can bill from.</h2>
        <p class="lead">Every enclosure, span and bore is photographed with time, date and GPS the moment the work is done. It is how our crews close out, not an extra step.</p>
        <ul class="cine__list">
          <li>Time and GPS-stamped photo per location</li>
          <li>Redlines and as-builts matched to prints</li>
          <li>OTDR and power meter results per fiber</li>
          <li>Daily production by span and footage</li>
        </ul>
      </div>
    </div>
    <p class="cine__cap">Route map and redlines, reviewed in the truck</p>
  </section>

  <!-- MARKETS TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => (
        <span class="ticker__set">{markets.flatMap((m) => m.places.map((p) => `${p}, ${m.state}`)).map((t) => <span>{t}</span>)}</span>
      ))}
    </div>
  </div>

  <!-- WHERE WE BUILD -->
  <section class="section where">
    <div class="wrap">
      <div class="grid where__head">
        <div class="where__title">
          <span class="label">Where we've built</span>
          <h2 class="h2" data-split>{markets.reduce((n, m) => n + m.places.length, 0)} markets across {states.length} states.</h2>
        </div>
        <div class="where__intro">
          <p class="lead">Programs supported through prime contractors for national and regional carriers. Based in Knoxville, working wherever the route goes.</p>
          <a class="link" href="/projects">See project work <Arrow /></a>
        </div>
      </div>
      <div class="where__map" data-reveal><USMap sites={jobsites} hq={hq} extraStates={extraStates} /></div>
      <div class="where__list">
        {markets.map((m) => (
          <div class="where__state">
            <span class="where__abbr">{m.state}</span>
            <ul>{m.places.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FIBERLYTIC -->
  <section class="section fl bg-ink" id="fiberlytic">
    <div class="wrap">
      <div class="grid fl__head">
        <div class="fl__title">
          <span class="label">Technology partner</span>
          <img class="fl__logo" src="/img/partners/fiberlytic-lockup.png" width="443" height="104" alt="FiberLytic" />
          <h2 class="h2" data-split>Our crews run on FiberLytic.</h2>
        </div>
        <div class="fl__copy">
          <p class="lead">FiberLytic is the operating system for fiber construction, and NextGen Fiber runs its field operations on it: production by span, GPS-stamped photos, redlines and closeout in one place, from the bucket to the office.</p>
          <a class="link" href="https://fiberlytic.com" rel="noopener" target="_blank">fiberlytic.com <Arrow /></a>
        </div>
      </div>
      <figure class="fl__film">
        <div class="fl__frame" data-film>
          <video muted loop playsinline preload="none" poster="/img/photos/fiberlytic-film-poster.webp" width="1920" height="1080" aria-label="NextGen Fiber crews in the field using FiberLytic" data-src="/video/nextgen-fiberlytic.mp4" data-src-small="/video/nextgen-fiberlytic-720.mp4"></video>
          <button class="fl__sound" type="button" data-sound aria-pressed="false">
            <svg class="fl__ico fl__ico--off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="1.8" fill="none"/></svg>
            <svg class="fl__ico fl__ico--on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="1.8" fill="none"/></svg>
            <span data-sound-label>Sound on</span>
          </button>
        </div>
        <figcaption class="annot fl__cap">NextGen Fiber crews in the field, filmed by SPM Creative for FiberLytic</figcaption>
      </figure>
    </div>
  </section>

  <!-- SAFETY TEASER -->
  <section class="section--tight safety-t bg-paper">
    <div class="wrap safety-t__row">
      <div>
        <span class="label">Safety & prequalification</span>
        <p class="h3">Daily tailboard, documented JHA and a certificate of insurance on request.</p>
      </div>
      <a class="btn btn--ghost" href="/safety">Safety & prequal <Arrow /></a>
    </div>
  </section>
</Base>

<style>
  /* HERO: full-bleed film loop under the overlay header */
  .hero { position: relative; min-height: min(92svh, 980px); margin-top: -76px; display: grid; align-items: end; color: var(--ivory); background: #0d0d0c; overflow: hidden; isolation: isolate; }
  .hero__media, .hero__poster, .hero__video, .hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__media { z-index: -1; }
  .hero__poster, .hero__video { object-fit: cover; }
  .hero__video { opacity: 0; transition: opacity .35s linear; }
  .hero__video.is-playing { opacity: 1; }
  .hero__shade { background: linear-gradient(90deg, rgba(13,13,12,.62) 0%, rgba(13,13,12,.25) 45%, rgba(13,13,12,0) 70%), linear-gradient(180deg, rgba(13,13,12,.55) 0%, rgba(13,13,12,.05) 26%, rgba(13,13,12,.1) 55%, rgba(13,13,12,.78) 100%); }
  .hero__inner { padding-block: 9rem clamp(3.5rem, 7vw, 6rem); display: grid; gap: 1.4rem; justify-items: start; }
  .hero__kicker { font-size: .95rem; font-weight: 500; color: rgba(247,246,242,.82); }
  .hero__h1 { font-size: clamp(2.4rem, 1.1rem + 3.9vw, 5rem); line-height: 1; letter-spacing: -.04em; font-weight: 700; max-width: 19ch; text-wrap: balance; }
  .hero__lead { font-size: var(--fs-lead); line-height: 1.5; max-width: 44ch; color: rgba(247,246,242,.86); }
  .hero__act { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; margin-top: .6rem; }
  .hero__call { color: var(--ivory); font-weight: 600; text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; padding-bottom: 2px; }
  .hero__call:hover { color: #fff; }
  .hero__cap { position: absolute; right: var(--gutter); bottom: 1.4rem; font-size: .8rem; color: rgba(247,246,242,.6); }

  /* MARKETS TICKER */
  .ticker { overflow: hidden; border-block: 1px solid var(--line); padding-block: 1.2rem; }
  .ticker__track { display: flex; width: max-content; animation: ticker 60s linear infinite; }
  .ticker:hover .ticker__track { animation-play-state: paused; }
  .ticker__set { display: flex; }
  .ticker__set span { font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem); font-weight: 650; letter-spacing: -.03em; padding-inline: 1.4rem; color: var(--ink-3); white-space: nowrap; }
  .ticker__set span::after { content: '·'; margin-left: 2.8rem; color: var(--gold); }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } }

  /* STATS */
  .stats { padding-top: clamp(3.5rem, 6vw, 5.5rem); }
  .stats__row { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); }
  .stat { padding: 2rem 1.5rem 2.2rem 0; display: grid; gap: .8rem; border-right: 1px solid var(--line); }
  .stat + .stat { padding-left: 1.5rem; }
  .stat:last-child { border-right: 0; }
  .stat__unit { font-size: .32em; font-weight: 700; letter-spacing: .1em; color: var(--mid); margin-left: .35em; text-transform: uppercase; }
  .stat__label { font-weight: 600; color: var(--ink-3); }
  .stats__note { margin-top: 1rem; }

  /* SERVICES */
  .svc__head { grid-column: 1 / span 4; display: grid; gap: 1.4rem; align-content: start; position: sticky; top: 110px; }
  .svc__list { grid-column: 6 / -1; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .svc__row { display: grid; grid-template-columns: 1fr 1.4fr 2rem; gap: 1.5rem; align-items: baseline; padding: 2rem 0; border-bottom: 1px solid var(--line); text-decoration: none; position: relative; }
  .svc__row::before { content: ''; position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: var(--gold); transition: width var(--t-med) var(--ease); }
  .svc__row:hover::before { width: 100%; }
  .svc__num { font-size: .8rem; font-weight: 800; letter-spacing: .12em; color: var(--gold-text); }
  .svc__name { font-size: var(--fs-h3); font-weight: 700; letter-spacing: -.025em; line-height: 1.1; }
  .svc__short { color: var(--mid-2); }
  .svc__go { justify-self: end; transition: transform var(--t-med) var(--ease); }
  .svc__row:hover .svc__go { transform: translateX(4px); color: var(--gold-text); }

  /* CINEMA SECTIONS: full-bleed photo, copy on a graded shade */
  .cine { position: relative; min-height: clamp(620px, 56.25vw, 980px); display: grid; align-items: end; color: var(--ivory); background: #0d0d0c; overflow: hidden; isolation: isolate; }
  .cine__media { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .cine__media :global(img) { position: absolute; left: 0; top: -7%; width: 100%; height: 114%; object-fit: cover; }
  .cine__shade { position: absolute; inset: 0; z-index: -1; }
  .cine--left .cine__shade { background: linear-gradient(90deg, rgba(13,13,12,.78) 0%, rgba(13,13,12,.45) 38%, rgba(13,13,12,0) 62%), linear-gradient(180deg, rgba(13,13,12,0) 55%, rgba(13,13,12,.85) 100%); }
  .cine--right .cine__shade { background: linear-gradient(270deg, rgba(13,13,12,.85) 0%, rgba(13,13,12,.55) 40%, rgba(13,13,12,.05) 68%); }
  .cine__inner { padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 5vw, 4.5rem); display: grid; gap: clamp(2rem, 4vw, 3.5rem); }
  .cine__copy { display: grid; gap: 1.3rem; max-width: 34rem; }
  .cine--right .cine__inner { justify-items: end; }
  .cine .label { color: rgba(247,246,242,.78); }
  .cine .lead { color: rgba(247,246,242,.88); }
  .cine__facts { margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; border-top: 1px solid rgba(247,246,242,.28); padding-top: 1.4rem; }
  .cine__facts dt { font-size: .85rem; color: rgba(247,246,242,.66); margin-bottom: .35rem; }
  .cine__facts dd { margin: 0; font-weight: 600; }
  .cine__list { list-style: none; margin: .4rem 0 0; padding: 0; }
  .cine__list li { padding: .75rem 0; border-top: 1px solid rgba(247,246,242,.22); font-weight: 600; }
  .cine__cap { position: absolute; right: var(--gutter); top: 1.4rem; font-size: .8rem; color: rgba(247,246,242,.7); text-shadow: 0 1px 8px rgba(0,0,0,.5); }
  .cine--right .cine__cap { right: auto; left: var(--gutter); }

  /* FIBERLYTIC */
  .fl__head { row-gap: 1.5rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .fl__title { grid-column: 1 / span 6; display: grid; gap: 1.4rem; justify-items: start; }
  .fl__copy { grid-column: 8 / -1; display: grid; gap: 1.2rem; justify-items: start; }
  .fl__copy .link { color: var(--ivory); }
  .fl__film { margin: 0; display: grid; gap: .9rem; }
  .fl__frame { position: relative; border-radius: var(--radius); overflow: hidden; background: #000; aspect-ratio: 16 / 9; }
  .fl__frame video { width: 100%; height: 100%; object-fit: cover; }
  .fl__logo { width: min(172px, 50%); height: auto; }
  .fl__sound { position: absolute; right: clamp(.8rem, 2vw, 1.4rem); bottom: clamp(.8rem, 2vw, 1.4rem); display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem .55rem .8rem; border: 1px solid rgba(247,246,242,.35); border-radius: var(--pill); background: rgba(16,16,16,.55); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: var(--ivory); font: inherit; font-size: .88rem; font-weight: 600; cursor: pointer; transition: border-color var(--t-fast), background var(--t-fast); }
  .fl__sound:hover { border-color: var(--ivory); background: rgba(16,16,16,.75); }
  .fl__ico { width: 18px; height: 18px; }
  .fl__sound[aria-pressed='false'] .fl__ico--on, .fl__sound[aria-pressed='true'] .fl__ico--off { display: none; }
  .fl__cap { color: rgba(247, 246, 242, .5); }

  /* PROCESS */
  .process__head { margin-bottom: 3.5rem; }
  .process__head { align-items: end; row-gap: 2rem; }
  .process__title { grid-column: 1 / span 6; display: grid; gap: 1.2rem; }
  .process__fig { grid-column: 8 / -1; max-width: 460px; justify-self: end; width: 100%; }
  .process__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .process__steps li { display: grid; gap: 1rem; align-content: start; }
  .process__num { font-size: 3.2rem; font-weight: 750; letter-spacing: -.05em; line-height: 1; color: var(--ink); }
  .process__line { height: 1px; background: var(--line-strong); position: relative; }
  .process__line::after { content: ''; position: absolute; left: 0; top: -1px; width: 32px; height: 3px; background: var(--gold); }

  /* WHERE: title and intro side by side, map full width, markets as inline text in columns */
  .where__head { row-gap: 1.2rem; align-items: end; }
  .where__title { grid-column: 1 / span 6; display: grid; gap: 1.2rem; }
  .where__intro { grid-column: 8 / -1; display: grid; gap: 1.1rem; justify-items: start; }
  .where__map { margin-block: clamp(2rem, 4vw, 3rem); }
  .where__list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 2.2rem; }
  .where__state { padding: 1.1rem 0; border-top: 1px solid var(--line-strong); display: grid; grid-template-columns: 2.6rem 1fr; align-items: start; }
  .where__abbr { font-weight: 800; letter-spacing: .08em; color: var(--gold-text); }
  .where__state ul { list-style: none; margin: 0; padding: 0; line-height: 1.6; font-size: .95rem; font-weight: 500; color: var(--ink-3); }
  .where__state li { display: inline; }
  .where__state li:not(:last-child)::after { content: ' · '; color: var(--mid); }

  .safety-t__row { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; justify-content: space-between; }
  .safety-t__row > div { display: grid; gap: .8rem; max-width: 46rem; }

  @media (max-width: 1080px) {
    .process__title, .process__fig { grid-column: 1 / -1; justify-self: start; }
    .svc__head { grid-column: 1 / -1; position: static; }
    .svc__list { grid-column: 1 / -1; }
    .fl__title, .fl__copy,
    .where__title, .where__intro { grid-column: 1 / -1; }
    .where__list { grid-template-columns: 1fr 1fr; }
    .cine__facts { grid-template-columns: 1fr 1fr; }
    .process__steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 1080px) {
    .stats__row { grid-template-columns: 1fr 1fr; }
    .stat { padding: 1.5rem 1rem 1.6rem 0; }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(3) { padding-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 720px) {
    /* Mobile: lay content out horizontally so the page stays short. */
    .section { padding-block: 3.5rem; }
    .svc__head { gap: 1rem; }
    .svc__row { padding: 1.05rem 0; }
    .svc__short { display: none; }
    .process__head { margin-bottom: 1.8rem; }
    .process__fig { display: none; }
