---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Arrow from '../../components/Arrow.astro';
import { services } from '../../data/services';
---
<Base title="Fiber Construction Services" description="Aerial construction, underground and HDD, fiber pulling, splicing and testing, and storm restoration crews for prime contractors in Tennessee, Alabama, North Carolina and Virginia.">
  <PageHead label="Services" title="Five crews. One route, strand to splice." lead="Hire a single crew type for a scope gap, or run the whole build with us. Every scope ends the same way: closeout documentation your PM can bill from." marker={0.1} />

  <section class="section svcx">
    <div class="wrap">
      {services.map((s) => (
        <article class="svcx__item grid" data-reveal>
          <div class="svcx__meta">
            <span class="index"><b>{s.index}</b> / 0{services.length}</span>
          </div>
          <div class="svcx__main">
            <h2 class="h2 svcx__name"><a href={`/services/${s.slug}`}>{s.name}</a></h2>
            <p class="lead">{s.short}</p>
            <a class="link" href={`/services/${s.slug}`}>Scope and deliverables <Arrow /></a>
          </div>
          <ul class="svcx__scope">
            {s.scope.slice(0, 4).map((x) => <li>{x}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .svcx { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .svcx__item { padding-block: clamp(2.5rem, 4vw, 3.5rem); border-bottom: 1px solid var(--line); row-gap: 1.5rem; align-items: start; }
  .svcx__item:first-child { border-top: 1px solid var(--line-strong); }
  .svcx__meta { grid-column: 1 / span 2; padding-top: .9rem; }
  .svcx__main { grid-column: 3 / span 6; display: grid; gap: 1.1rem; }
  .svcx__name a { text-decoration: none; background: linear-gradient(var(--gold), var(--gold)) 0 100% / 0 2px no-repeat; transition: background-size var(--t-med) var(--ease); }
  .svcx__name a:hover { background-size: 100% 2px; }
  .svcx__scope { grid-column: 9 / -1; list-style: none; margin: 0; padding: .9rem 0 0; display: grid; gap: .55rem; font-weight: 600; color: var(--ink-3); }
  .svcx__scope li { display: flex; gap: .7rem; align-items: baseline; }
  .svcx__scope li::before { content: ''; flex: none; width: 5px; height: 5px; background: var(--gold); transform: translateY(-2px); }
  @media (max-width: 1080px) {
    .svcx__meta { grid-column: 1 / -1; padding-top: 0; }
    .svcx__main, .svcx__scope { grid-column: 1 / -1; }
    .svcx__scope { padding-top: 0; }
  }
</style>
