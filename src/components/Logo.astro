---
// The NextGen logo is always the official artwork — never re-typed in a web font.
// With the wordmark: the lockup (mark + NEXTGEN / FIBER, gold shadow).
// Without it: the monogram alone. Dark artwork on light surfaces, light on dark ones.
interface Props { tone?: 'dark' | 'light'; size?: number; wordmark?: boolean }
const { tone = 'dark', size = 40, wordmark = true } = Astro.props;
const mark = `/img/brand/mark-${tone}-128.png`;
const mark2 = `/img/brand/mark-${tone}-256.png`;
const lockup = `/img/brand/lockup-${tone}.png`;
const lw = Math.round(size * 576 / 180);
---
<span class={`logo logo--${tone}`} style={`--s:${size}px`}>
  {wordmark
    ? <img src={lockup} width={lw} height={size} alt="NextGen Fiber" />
    : <img src={mark} srcset={`${mark} 1x, ${mark2} 2x`} width={size} height={size} alt="NextGen Fiber" />}
</span>
<style>
  .logo { display: inline-flex; align-items: center; }
  .logo img { flex: none; display: block; height: var(--s); width: auto; }
</style>
