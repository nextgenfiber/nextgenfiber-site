---
// Line-art technical figure for each service, in the same drawing language as
// the home route schematic. Decorative only.
interface Props { slug: string }
const { slug } = Astro.props;
const poles = [60, 180, 300, 420];
---
<figure class="sf" aria-hidden="true">
  <svg class="sf__svg draw" viewBox="0 0 480 300" fill="none">
    <defs>
      <pattern id={`sf-grid-${slug}`} width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" stroke="var(--line)" /></pattern>
    </defs>
    <rect width="480" height="300" fill={`url(#sf-grid-${slug})`} opacity=".6" />

    {slug === 'aerial-construction' && (
      <g>
        {poles.map((x) => <line class="sf__k" x1={x} y1="70" x2={x} y2="250" />)}
        <path class="sf__k sf__w" d="M60 96 Q120 112 180 96 Q240 112 300 96 Q360 112 420 96" />
        <path class="sf__g sf__w" d="M60 104 Q120 120 180 104 Q240 120 300 104 Q360 120 420 104" />
        <line class="sf__k" x1="420" y1="96" x2="462" y2="250" />
        <line class="sf__grade" x1="0" y1="250" x2="480" y2="250" />
        <text class="sf__t" x="98" y="84">STRAND + LASH</text>
        <text class="sf__t" x="330" y="140">DOWN GUY</text>
        <text class="sf__t" x="16" y="276">GRADE</text>
      </g>
    )}
    {slug === 'underground-hdd' && (
      <g>
        <line class="sf__grade" x1="0" y1="90" x2="480" y2="90" />
        <rect class="sf__box" x="36" y="90" width="44" height="34" />
        <rect class="sf__box" x="400" y="90" width="44" height="34" />
        <path class="sf__k sf__w" d="M80 112 C 150 112, 150 210, 240 210 S 330 112, 400 112" />
        <path class="sf__g sf__d" d="M80 118 C 150 118, 150 216, 240 216 S 330 118, 400 118" />
        <line class="sf__dim" x1="240" y1="90" x2="240" y2="210" />
        <text class="sf__t" x="248" y="156">DEPTH</text>
        <text class="sf__t" x="18" y="80">HANDHOLE</text>
        <text class="sf__t" x="190" y="244">HDD BORE · CONDUIT</text>
        <text class="sf__t" x="410" y="80">GRADE</text>
      </g>
    )}
    {slug === 'fiber-pulling' && (
      <g>
        <circle class="sf__k" cx="150" cy="150" r="86" />
        <circle class="sf__k" cx="118" cy="120" r="26" />
        <circle class="sf__g" cx="182" cy="120" r="26" />
        <circle class="sf__k" cx="150" cy="178" r="26" />
        <circle class="sf__fill" cx="182" cy="120" r="7" />
        <path class="sf__k sf__w" d="M270 150 H 460" />
        <path class="sf__g sf__w" d="M270 158 H 430" />
        <text class="sf__t" x="98" y="262">DUCT · INNERDUCT</text>
        <text class="sf__t" x="300" y="136">TENSION · BEND RADIUS</text>
        <text class="sf__t" x="300" y="184">SLACK COIL AT ACCESS</text>
      </g>
    )}
    {slug === 'splicing-testing' && (
      <g>
        <rect class="sf__box" x="150" y="80" width="180" height="120" rx="6" />
        {[0, 1, 2, 3, 4, 5].map((i) => <line class={i % 2 ? 'sf__g' : 'sf__k'} x1="30" y1={100 + i * 16} x2="150" y2={100 + i * 16} />)}
        {[0, 1, 2, 3, 4, 5].map((i) => <line class={i % 2 ? 'sf__g' : 'sf__k'} x1="330" y1={100 + i * 16} x2="450" y2={100 + i * 16} />)}
        {[0, 1, 2, 3, 4, 5].map((i) => <rect class="sf__fill" x="236" y={97 + i * 16} width="8" height="6" />)}
        <path class="sf__k" d="M30 250 L 90 250 L 96 238 L 102 250 L 300 256 L 450 262" />
        <text class="sf__t" x="160" y="72">ENCLOSURE · FUSION SPLICES</text>
        <text class="sf__t" x="30" y="284">OTDR TRACE</text>
      </g>
    )}
    {slug === 'storm-restoration' && (
      <g>
        {[60, 180].map((x) => <line class="sf__k" x1={x} y1="70" x2={x} y2="250" />)}
        <line class="sf__k" x1="300" y1="250" x2="360" y2="120" />
        <line class="sf__k" x1="420" y1="70" x2="420" y2="250" />
        <path class="sf__k sf__w" d="M60 96 Q120 112 180 96 L 250 150" />
        <path class="sf__k sf__w" d="M420 96 L 380 150" />
        <path class="sf__g sf__d" d="M180 104 Q300 124 420 104" />
        <line class="sf__grade" x1="0" y1="250" x2="480" y2="250" />
        <text class="sf__t" x="236" y="96">RESTORED SPAN</text>
        <text class="sf__t" x="300" y="276">DAMAGE · LOC. 07</text>
      </g>
    )}
  </svg>
</figure>

<style>
  .sf { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }
  .sf__svg { width: 100%; height: auto; }
  .sf__k { stroke: var(--ink); stroke-width: 1.4; }
  .sf__g { stroke: var(--gold); stroke-width: 1.6; }
  .sf__w { stroke-width: 2.4; }
  .sf__d { stroke-dasharray: 7 5 !important; stroke-dashoffset: 0 !important; }
  .sf__box { stroke: var(--ink); stroke-width: 1.4; fill: var(--ivory); }
  .sf__fill { fill: var(--gold); }
  .sf__grade { stroke: var(--line-strong); stroke-dasharray: 2 4 !important; stroke-dashoffset: 0 !important; }
  .sf__dim { stroke: var(--mid); stroke-dasharray: 3 3 !important; stroke-dashoffset: 0 !important; }
  .sf__t { font: 600 9.5px/1 var(--font); letter-spacing: .12em; fill: var(--mid); }
</style>
