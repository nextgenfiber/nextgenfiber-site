---
// Illustrative route schematic: aerial pole line (double strand, like the
// logo's double stroke), an HDD bore segment and splice enclosures, with a
// gold signal moving through the network. Purely decorative.
const poles = [
  [70, 150], [170, 138], [270, 132], [370, 136], [470, 150],
];
---
<figure class="rs" aria-hidden="true">
  <svg class="rs__svg draw" viewBox="0 0 640 560" fill="none">
    <defs>
      <pattern id="rs-grid" width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M32 0H0V32" stroke="var(--line)" stroke-width="1" />
      </pattern>
    </defs>
    <rect x="0" y="0" width="640" height="560" fill="url(#rs-grid)" opacity=".55" />

    <!-- rulers -->
    <g class="rs__ruler">
      {Array.from({ length: 21 }, (_, i) => <line x1={i * 32} y1="0" x2={i * 32} y2={i % 5 === 0 ? 14 : 7} />)}
      {Array.from({ length: 18 }, (_, i) => <line x1="0" y1={i * 32} x2={i % 5 === 0 ? 14 : 7} y2={i * 32} />)}
    </g>
    <text class="rs__t" x="20" y="30">0</text>
    <text class="rs__t" x="164" y="30">500 FT</text>
    <text class="rs__t" x="324" y="30">1,000 FT</text>

    <!-- aerial: double strand between poles (logo double-stroke motif) -->
    <polyline class="rs__strand" points={poles.map(([x, y]) => `${x},${y}`).join(' ')} />
    <polyline class="rs__strand rs__strand--b" points={poles.map(([x, y]) => `${x + 5},${y + 6}`).join(' ')} />
    {poles.map(([x, y], i) => (
      <g>
        <line class="rs__pole" x1={x} y1={y - 18} x2={x} y2={y + 42} />
        <rect class="rs__node" x={x - 4} y={y - 4} width="8" height="8" />
        <text class="rs__t" x={x - 16} y={y + 60}>P-{101 + i}</text>
      </g>
    ))}
    <text class="rs__t rs__t--k" x="96" y="118">SPAN 214 FT</text>

    <!-- riser down to underground -->
    <polyline class="rs__cable" points="470,150 470,300 520,300" />
    <!-- underground HDD segment -->
    <path class="rs__bore" d="M520 300 C 560 300, 580 340, 580 380 S 560 460, 470 470 L 250 470" />
    <text class="rs__t" x="330" y="494">HDD BORE · 1.25" CONDUIT</text>
    <line class="rs__surface" x1="220" y1="410" x2="620" y2="410" />
    <text class="rs__t" x="560" y="402">GRADE</text>

    <!-- drops / laterals -->
    <polyline class="rs__cable" points="270,132 270,250 200,250" />
    <polyline class="rs__cable" points="170,138 170,330 120,330" />

    <!-- splice enclosures -->
    <g class="rs__encl"><circle cx="200" cy="250" r="11" /><circle class="rs__encl-core" cx="200" cy="250" r="4" /></g>
    <text class="rs__t rs__t--k" x="142" y="278">SPLICE ENCL. 04</text>
    <g class="rs__encl"><circle cx="120" cy="330" r="11" /><circle class="rs__encl-core" cx="120" cy="330" r="4" /></g>
    <text class="rs__t" x="60" y="358">TERMINAL 12F</text>
    <g class="rs__encl"><circle cx="250" cy="470" r="11" /><circle class="rs__encl-core" cx="250" cy="470" r="4" /></g>
    <text class="rs__t rs__t--k" x="196" y="500">HANDHOLE 17×30</text>

    <!-- hub -->
    <g class="rs__hub"><rect x="520" y="104" width="72" height="92" rx="2" /><line x1="532" y1="126" x2="580" y2="126" /><line x1="532" y1="140" x2="580" y2="140" /><line x1="532" y1="154" x2="580" y2="154" /></g>
    <polyline class="rs__cable" points="470,150 520,150" />
    <text class="rs__t rs__t--k" x="520" y="92">HUB · KNOXVILLE, TN</text>
    <text class="rs__t" x="520" y="216">35.98° N · 83.92° W</text>

    <!-- signal traveling through the network -->
    <polyline class="rs__signal" points={poles.map(([x, y]) => `${x},${y}`).join(' ') + ' 470,300 520,300'} />
    <path class="rs__signal rs__signal--2" d="M520 300 C 560 300, 580 340, 580 380 S 560 460, 470 470 L 250 470" />
  </svg>
  <figcaption class="annot rs__cap">Route schematic · aerial + underground</figcaption>
</figure>

<style>
  .rs { margin: 0; position: relative; }
  .rs__svg { width: 100%; height: auto; }
  .rs__ruler line { stroke: var(--line-strong); stroke-width: 1; }
  .rs__t { font: 600 9.5px/1 var(--font); letter-spacing: .12em; fill: var(--mid); }
  .rs__t--k { fill: var(--ink); }
  .rs__strand { stroke: var(--ink); stroke-width: 2.4; }
  .rs__strand--b { stroke: var(--gold); stroke-width: 2.4; }
  .rs__pole { stroke: var(--ink-3); stroke-width: 1.2; }
  .rs__node { fill: var(--ivory); stroke: var(--ink); stroke-width: 1.4; }
  .rs__cable { stroke: var(--ink); stroke-width: 1.4; }
  .rs__bore { stroke: var(--ink); stroke-width: 1.6; stroke-dasharray: 7 5 !important; stroke-dashoffset: 0 !important; }
  .rs__surface { stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 2 4 !important; stroke-dashoffset: 0 !important; }
  .rs__encl circle { fill: var(--ivory); stroke: var(--ink); stroke-width: 1.4; }
  .rs__encl .rs__encl-core { fill: var(--gold); stroke: none; }
  .rs__hub rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1.4; }
  .rs__hub line { stroke: var(--gold); stroke-width: 1.4; }
  .rs__signal { stroke: var(--gold); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 18 1400 !important; stroke-dashoffset: 1418; animation: signal 5.5s var(--ease-io) infinite; filter: drop-shadow(0 0 3px rgba(172, 143, 22, .55)); }
  .rs__signal--2 { animation-delay: 2.2s; stroke-dasharray: 16 900 !important; }
  @keyframes signal { to { stroke-dashoffset: 0; } }
  .rs__cap { position: absolute; left: 0; bottom: -1.75rem; }
  @media (prefers-reduced-motion: reduce) { .rs__signal { display: none; } }
</style>
